{% extends '@ea/layout.html.twig' %}

{% form_theme form with ['@ea/crud/form_theme.html.twig'] %}

{% block content_title %}
    {{ 'Create App Notification'|trans }}
{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-6 col-xxl-5">
            {{ form_start(form, {attr: {id: 'app-notification-create'}}) }}
            {{ form(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block page_actions_wrapper %}
    <button type="submit" class="btn btn-primary" form="app-notification-create">
        {{ 'Send App Notification'|trans }}
    </button>
{% endblock %}
